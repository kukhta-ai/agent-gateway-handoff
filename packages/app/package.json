{
  "name": "@gla/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "COMPOSITION ROOT · boots the :3000 process and wires deployable ports through provider sets.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "gla": "./bin/gla.mjs"
  },
  "files": ["dist", "bin"],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "serve": "node ./bin/gla.mjs serve"
  },
  "dependencies": {
    "@gla/admission": "workspace:*",
    "@gla/assembly": "workspace:*",
    "@gla/audit": "workspace:*",
    "@gla/bridge": "workspace:*",
    "@gla/capability": "workspace:*",
    "@gla/catalog": "workspace:*",
    "@gla/cli": "workspace:*",
    "@gla/completion": "workspace:*",
    "@gla/gateway": "workspace:*",
    "@gla/identity": "workspace:*",
    "@gla/kernel": "workspace:*",
    "@gla/launcher-process": "workspace:*",
    "@gla/mcp": "workspace:*",
    "@gla/policy-cedar": "workspace:*",
    "@gla/provider-host": "workspace:*",
    "@gla/provider-set-reference": "workspace:*",
    "@gla/route": "workspace:*",
    "@gla/session": "workspace:*",
    "@gla/task": "workspace:*",
    "@gla/worker": "workspace:*",
    "@gla/workspace-profile": "workspace:*"
  },
  "devDependencies": {
    "@gla/auth-authentik": "workspace:*",
    "@gla/auth-webauthn": "workspace:*",
    "playwright-core": "^1.49.1"
  }
}

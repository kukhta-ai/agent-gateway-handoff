{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "files": {
    "ignoreUnknown": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": false,
      "nursery": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@gla/connector-cdp": "Boundary violation (baseline 1): only packages/app may import a concrete adapter."
            }
          }
        }
      }
    }
  }
}

{
  "//": "EXAMPLE DependencyBinding records for the identity-provider dependency, authentik branch (GLA-074/084).",
  "//1": "wpm writes one rendered binding into the verify task receipt; GLA reads it and re-probes it. Dynamic",
  "//2": "receipt evidence is separate from deterministic bundle metadata. Secrets are never literals here.",
  "//3": "The client secret is represented only by a secret-ref pointer resolved by the secret seam.",

  "example_local_external_adopted": {
    "dependency": "identity-provider",
    "source": "wpm-receipt",
    "ownershipMode": "local-external",
    "state": "adopted",
    "bundle": {
      "id": "identity-provider",
      "version": "0.1.0",
      "declaredRequires": {
        "gla-core": "^0.1.0"
      },
      "templateRefs": ["payload/templates/dependency-binding.example.json"]
    },
    "receipt": {
      "taskId": "identity-provider-6",
      "status": "Done",
      "recordedAt": "2026-06-13T00:00:00.000Z",
      "refs": [
        "wpm/wip/bundles/identity-provider/install-backlog/tasks/identity-provider-6 - Verify-authentik-end-to-end-and-record-the-dependency-binding.md"
      ],
      "checksums": {
        "dependency-binding.json": "sha256:example"
      }
    },
    "connection": {
      "refs": {
        "issuer": { "kind": "uri-ref", "ref": "https://idp.example/application/o/gla/" },
        "clientId": { "kind": "literal", "ref": "gla" },
        "redirectUri": { "kind": "uri-ref", "ref": "https://57.131.31.126/auth/callback" },
        "scopes": { "kind": "literal", "ref": "openid profile" },
        "clientSecret": { "kind": "secret-ref", "ref": "secret://gla/authentik/client-secret" }
      }
    },
    "lastProbe": {
      "at": "2026-06-13T00:00:00.000Z",
      "result": "available",
      "detail": "discovery 200; jwks 2 keys; authorize accepts gla redirect; amr distinguishes swk to webauthn and pwd to password; enroll and re-auth keep same subject"
    },
    "decisionNotes": [
      {
        "note": "Adopted existing authentik instance; GLA owns only its client registration and local connection binding.",
        "rationale": "Operator chose local-external ownership, so no inverse operation is recorded."
      }
    ]
  },

  "example_managed_installed": {
    "dependency": "identity-provider",
    "source": "wpm-receipt",
    "ownershipMode": "managed",
    "state": "installed",
    "bundle": {
      "id": "identity-provider",
      "version": "0.1.0",
      "declaredRequires": {
        "gla-core": "^0.1.0"
      },
      "templateRefs": ["payload/templates/dependency-binding.example.json"],
      "scriptRefs": ["payload/scripts/verify-authentik.mjs"]
    },
    "receipt": {
      "taskId": "identity-provider-6",
      "status": "Done",
      "recordedAt": "2026-06-13T00:00:00.000Z",
      "refs": [
        "wpm/wip/bundles/identity-provider/install-backlog/tasks/identity-provider-6 - Verify-authentik-end-to-end-and-record-the-dependency-binding.md"
      ],
      "checksums": {
        "dependency-binding.json": "sha256:example"
      }
    },
    "connection": {
      "refs": {
        "issuer": { "kind": "uri-ref", "ref": "https://idp.example/application/o/gla/" },
        "clientId": { "kind": "literal", "ref": "gla" },
        "redirectUri": { "kind": "uri-ref", "ref": "https://57.131.31.126/auth/callback" },
        "scopes": { "kind": "literal", "ref": "openid profile" },
        "clientSecret": { "kind": "secret-ref", "ref": "secret://gla/authentik/client-secret" }
      }
    },
    "lastProbe": {
      "at": "2026-06-13T00:00:00.000Z",
      "result": "available",
      "detail": "managed authentik stack is reachable; discovery, jwks, authorize, password amr, and subject stability probes passed"
    },
    "inverseOp": {
      "description": "Remove only the authentik stack and client registration installed by this bundle.",
      "command": "identity-provider/teardown-authentik-managed",
      "condition": "Only valid when receipt ownershipMode is managed and this bundle created the stack."
    },
    "decisionNotes": [
      {
        "note": "Managed install owns server, worker, database, and client registration lifecycle.",
        "rationale": "Use inverseOp for repair or uninstall rather than ad hoc host commands."
      }
    ]
  },

  "example_unavailable": {
    "dependency": "identity-provider",
    "source": "wpm-receipt",
    "ownershipMode": "remote-external",
    "state": "remote",
    "bundle": {
      "id": "identity-provider",
      "version": "0.1.0",

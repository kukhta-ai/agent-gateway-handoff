{
  "//": "EXAMPLE DependencyBinding records for the identity-provider dependency, authentik branch (GLA-074/084/085).",
  "//1": "wpm writes one rendered binding into the verify task receipt; GLA reads it and re-probes it. Dynamic",
  "//2": "receipt evidence is separate from deterministic bundle metadata. Secrets are never literals here.",
  "//3": "The client secret is represented only by a secret-ref pointer resolved by the secret seam.",
  "//4": "loginMethodProofs under lastProbe.detail are WPM receipt detail. Do not copy receipt-only fields such as loginChoiceVisible, observedClaims, assuranceOutcome, or eligiblePolicies into GLA_AUTH_ENROLLMENT_POLICY_JSON; the daemon descriptor accepts method, kind, label, stage, source, status, authStrength, assuranceLevel, observedAt, subjectStable, evidence, and diagnostics.",

  "example_local_external_adopted": {
    "dependency": "identity-provider",
    "source": "wpm-receipt",
    "ownershipMode": "local-external",
    "state": "adopted",
    "bundle": {
      "id": "identity-provider",
      "version": "0.1.0",
      "declaredRequires": {
        "gla-core": "^0.1.0"
      },
      "templateRefs": ["payload/templates/dependency-binding.example.json"]
    },
    "receipt": {
      "taskId": "identity-provider-6",
      "status": "Done",
      "recordedAt": "2026-06-13T00:00:00.000Z",
      "refs": [
        "wpm/wip/bundles/identity-provider/install-backlog/tasks/identity-provider-6 - Verify-authentik-end-to-end-and-record-the-dependency-binding.md"
      ],
      "checksums": {
        "dependency-binding.json": "sha256:example"
      }
    },
    "connection": {
      "refs": {
        "issuer": { "kind": "uri-ref", "ref": "https://idp.example/application/o/gla/" },
        "clientId": { "kind": "literal", "ref": "gla" },
        "redirectUri": { "kind": "uri-ref", "ref": "https://57.131.31.126/auth/callback" },
        "scopes": { "kind": "literal", "ref": "openid profile" },
        "enrollmentPolicy": {
          "kind": "literal",
          "ref": "authentik:gla-invitation-enrollment; credentials=password,webauthn-passkey; sources=oauth:github; choices=primary-credential[password|webauthn-passkey|oauth:github]"
        },
        "clientSecret": { "kind": "secret-ref", "ref": "secret://gla/authentik/client-secret" }
      }
    },
    "lastProbe": {
      "at": "2026-06-13T00:00:00.000Z",
      "result": "available",
      "detail": {
        "checks": [
          "discovery 200",
          "jwks 2 keys",
          "authorize accepts gla redirect",
          "enrollment policy descriptor visible in gla auth diagnostics",
          "enroll and re-auth keep same subject"
        ],
        "loginMethodProofs": [
          {
            "method": "password",
            "kind": "password",
            "status": "verified",
            "loginChoiceVisible": true,
            "stage": "gla-password-prompt",
            "authStrength": "password",
            "assuranceLevel": "password",
            "evidence": { "amr": ["pwd"], "gla_uv": false },
            "eligiblePolicies": ["password-permitted"],
            "evidenceHandling": "claims-only; no id_token, access token, password, code, verifier, or grant recorded"
          },
          {
            "method": "webauthn-passkey",
            "kind": "webauthn-passkey",
            "status": "verified",
            "loginChoiceVisible": true,
            "stage": "gla-webauthn-validation",
            "recipientRequirement": "enrolled compatible authenticator",
            "authStrength": "webauthn",
            "assuranceLevel": "phishing-resistant",
            "evidence": {
              "amr": ["swk"],
              "gla_uv": true,
              "recipientBound": true,
              "replayResistant": true
            },
            "eligiblePolicies": ["phishing-resistant", "password-permitted"],
            "evidenceHandling": "claims-only; user verification is recorded as a boolean proof, never passkey material"
          },
          {
            "method": "oauth:github",
            "kind": "external-source",
            "status": "verified",
            "loginChoiceVisible": true,
            "source": "github-oauth",
            "subjectStable": true,
            "authStrength": "password",
            "assuranceLevel": "password",
            "evidence": {
              "source": "github-oauth",
              "subjectMode": "stable"
            },
            "eligiblePolicies": [
              "password-permitted when policy explicitly accepts this mapped source evidence"
            ],
            "evidenceHandling": "source id/name and stable-subject status only; no source token or profile payload recorded"
          }
        ],
        "redaction": "secret-ref-only for client secret; provider tokens, OIDC codes, code verifiers, grants, invitations, passwords, and passkey material omitted"
      }
    },
    "decisionNotes": [
      {
        "note": "Adopted existing authentik instance; GLA owns only its client registration and local connection binding.",
        "rationale": "Operator chose local-external ownership, so no inverse operation is recorded."
      }
    ]
  },


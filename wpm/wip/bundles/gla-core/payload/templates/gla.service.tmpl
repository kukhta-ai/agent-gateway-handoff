# gla.service — a systemd unit that runs the GLA daemon (`gla serve`), the long-running :3000 deployable.
#
# TEMPLATE (lower-trust tier): the executing agent fills ⟨…⟩ for THIS host and installs the result as either
#   • a USER unit   — ~/.config/systemd/user/gla.service  + `systemctl --user enable --now gla` + linger
#                     (least privilege; the bridge socket lands at /run/user/<uid>/gla.sock). Preferred when
#                     the operator user can run the browser/view stack. This is the hermes-1 default.
#   • a SYSTEM unit — /etc/systemd/system/gla.service     + `systemctl enable --now gla`  (needs root; set
#                     User=/Group= below and a fixed bridge socket via GLA_ENDPOINT in the env file).
# If systemd is unavailable, the documented fallback run command (see the bundle's setup task) is equivalent:
#     env $(grep -v '^#' gla.env | xargs) node packages/app/bin/gla.mjs serve
#
# The receipt records which form was installed (user vs system), the unit path placed, and the inverse op
# (`systemctl [--user] disable --now gla` + remove the unit), so uninstall reverses exactly what was added.

[Unit]
Description=GLA — Gateway Live Access daemon (Access Gateway :3000 + local Agent Bridge socket)
Documentation=https://github.com/your-org/gla
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# WorkingDirectory MUST be the GLA build root (where packages/app/bin/gla.mjs resolves the workspace).
WorkingDirectory=⟨/opt/gla⟩
# All deployment knobs (GLA_PUBLIC_BASE_URL, GLA_PORT, GLA_RP_ID, …) come from the env file the bundle placed.
EnvironmentFile=⟨/opt/gla/gla.env⟩
# The daemon itself — the exact command the bundle stands up:
#   GLA_PUBLIC_BASE_URL=https://<vps-ip>/ GLA_PORT=3000 node packages/app/bin/gla.mjs serve
ExecStart=⟨/usr/bin/node⟩ packages/app/bin/gla.mjs serve
# SIGINT/SIGTERM trigger the daemon's graceful shutdown (tears down live capsules, removes the socket).
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=5
# For a SYSTEM unit, run as the operator (NOT root) and give it a writable runtime dir for the bridge socket:
#   User=⟨op⟩
#   Group=⟨op⟩
#   RuntimeDirectory=gla          # → /run/gla, and set GLA_ENDPOINT=/run/gla/gla.sock in the env file
# For a USER unit these are omitted (the service already runs as the operator; the socket lands in
# $XDG_RUNTIME_DIR = /run/user/<uid>).

[Install]
# USER unit:   WantedBy=default.target   SYSTEM unit:   WantedBy=multi-user.target
WantedBy=⟨default.target⟩

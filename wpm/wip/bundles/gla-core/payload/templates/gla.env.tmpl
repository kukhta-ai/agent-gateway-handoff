# gla.env — environment for the `gla serve` daemon (read by the systemd unit's EnvironmentFile=).
#
# This is a TEMPLATE (the lower-trust payload tier): the executing agent fills the ⟨…⟩ placeholders for THIS
# host, places the result (the receipt records the checksum of what was actually written), and points the
# service at it. Flags win over env, but the service is launched without flags, so these values govern.
# Do not leave template/redaction placeholders in the placed file: `gla serve` refuses values such as `***`,
# `<redacted>`, `<secret>`, or `⟨...⟩` rather than accepting them as real config or secrets.
#
# The daemon binds two doors (docs/01 §2, docs/05 §"Connection & auth"):
#   • the Access Gateway — the SOLE PUBLIC entry — on  GLA_HOST:GLA_PORT   (front it with a TLS reverse proxy)
#   • the Agent Bridge   — LOCAL ONLY — on a unix socket ($XDG_RUNTIME_DIR/gla.sock, else /run/gla.sock)
# The bridge is refused if it would bind anything non-local (fail-closed); leave it on the socket.

# ── Public edge ──────────────────────────────────────────────────────────────────────────────────────────
# The bind host/port for the public Access Gateway. 0.0.0.0:3000 is the deploy target; a reverse proxy (the
# edge-proxy bundle's Caddy) terminates TLS in front of it and forwards here.
GLA_HOST=0.0.0.0
GLA_PORT=3000

# The PUBLIC base URL every handoff/enrollment link is built against — it MUST be the URL a recipient's phone
# can actually open, NOT the container's internal address. Set it to whatever is externally reachable RIGHT NOW:
#   • with the edge-proxy bundle (or any TLS reverse proxy) in front — the proxy's https URL (preferred).
#     On hermes-1 the host Caddy serves https://⟨vps-ip⟩/ and a forkproxy maps host:13000 → container:3000.
#       hermes-1 value:  https://203.0.113.10/
#       root example:    GLA_PUBLIC_BASE_URL=https://gla.example/
#       subpath example: GLA_PUBLIC_BASE_URL=https://gla.example/team-a/
#     For subpath mounts, route the public prefix to GLA and either strip it while sending
#     X-Forwarded-Prefix=/team-a or preserve it unchanged; GLA still enforces all grant/recipient checks.
#     If the proxy strips the prefix and uses X-Forwarded-Prefix, set GLA_TRUST_FORWARDED_PREFIX=true only when
#     that proxy overwrites/sanitizes client-supplied X-Forwarded-Prefix before it reaches GLA. Prefix-preserving
#     proxies should leave this false.
#   • gla-core standalone, no proxy yet — the host's own reachable address and port, e.g. http://⟨public-ip⟩:3000/
#     (plain HTTP; fine for a first bring-up). When edge-proxy is later added, update this to the https URL and
#     restart the service so new links use it. WebAuthn needs https or localhost, so passkeys require the proxy.
GLA_PUBLIC_BASE_URL=⟨https://your-public-host/⟩
GLA_TRUST_FORWARDED_PREFIX=false

# ── WebAuthn / passkey relying party (identity-provider bundle) ──────────────────────────────────────────
# The RP id is the registrable domain the passkey is bound to; it MUST match the host in GLA_PUBLIC_BASE_URL
# (an IP literal is a valid RP id for a bare-IP deploy). The expected ceremony origin is derived from the
# public base URL. RP name is the human-facing label shown in the passkey prompt.
#   hermes-1 value:  GLA_RP_ID=203.0.113.10
GLA_RP_ID=⟨your-public-host⟩
GLA_RP_NAME=GLA

# ── Handoff auth assurance policy ───────────────────────────────────────────────────────────────────────
# phishing-resistant (default) requires passkey/phishing-resistant evidence before handoff. Use
# password-permitted only when accepting password-grade evidence is an explicit deployment policy.
GLA_AUTH_ASSURANCE_POLICY=phishing-resistant

# ── Optional delegated authentik / OIDC provider ─────────────────────────────────────────────────────────
# Leave these unset for the default in-tree WebAuthn provider. If selected, the issuer may live on a separate
# authentik origin, while the redirect URI MUST land back under GLA_PUBLIC_BASE_URL on the GLA gateway origin.
# The GLA grant never goes to authentik; authentik sees only OIDC code/state.
#   separate issuer + subpath callback example:
#     GLA_AUTH_PROVIDER=authentik
#     GLA_AUTHENTIK_ISSUER_URL=https://idp.example/application/o/gla/
#     GLA_AUTHENTIK_REDIRECT_URI=https://gla.example/team-a/auth/callback
#     GLA_AUTHENTIK_CLIENT_ID=⟨client-id⟩
#     GLA_AUTHENTIK_CLIENT_SECRET=<resolved-secret-value-from-secret-store>

# ── Capsule isolation / launcher tier (isolation + browser-runtime + human-view bundles) ─────────────────
# auto    → full noVNC view if Xvfb/x11vnc/websockify are present (human-view bundle), else headless.
# full    → force the noVNC human-view path (requires the human-view stack).
# headless→ browser-only (CDP connector), no human view.
# This is the process-tier launcher (the default isolation tier); Docker is the opt-in alternative.
GLA_LAUNCHER_MODE=auto
